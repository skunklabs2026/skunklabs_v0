# SkunkLabs MVP V0 — configuration.
# Copy to .env and edit. Every value has a working default; .env is optional.
# Full list and defaults: backend/config/settings.py

# ---------------- Video source ----------------
# file = replay a recorded clip (repeatable, the demo default)
# camera = live USB / built-in camera
SKUNK_VIDEO_SOURCE=file
SKUNK_VIDEO_PATH=assets/videos/demo_drone.mp4
SKUNK_CAMERA_INDEX=0
SKUNK_TARGET_FPS=25
SKUNK_FRAME_WIDTH=960
SKUNK_LOOP_VIDEO=true

# ---------------- Detector ----------------
# motion = OpenCV background subtraction (no model download, most reliable)
# yolo   = Ultralytics YOLO26n (needs: pip install -r requirements-yolo.txt)
SKUNK_DETECTOR=motion
SKUNK_DETECTION_THRESHOLD=0.55

# yolo only
SKUNK_MODEL_PATH=yolo26n.pt
SKUNK_DEVICE=auto          # auto | mps | cpu

# ---------------- Confirmation rules (demo logic) ----------------
# Seconds a track must be held before THREAT_CONFIRMED.
SKUNK_CONFIRMATION_TIME=2.0
SKUNK_CONFIRMATION_CONFIDENCE=0.60
# Seconds of FOLLOWING before the AUTHORIZE control is offered.
SKUNK_FOLLOW_TIME=1.5

# ---------------- Track loss / reset ----------------
SKUNK_TARGET_LOST_GRACE=1.0
SKUNK_TARGET_LOST_HOLD=2.5
# Seconds ACTUATED is held before auto-reset. 0 = manual reset only.
SKUNK_ACTUATED_HOLD=6.0

# ---------------- Platform classification ----------------
# FPV multirotor vs fixed-wing, from track kinematics. Sets the prediction
# horizon and the assumed airframe size used for the speed estimate.
# ~3.6s at 25 fps — shorter windows see only one leg of a weaving flight.
SKUNK_PLATFORM_WINDOW=90
SKUNK_PLATFORM_STRAIGHT_THRESHOLD=0.93
SKUNK_PLATFORM_TURN_RATE_THRESHOLD=35
SKUNK_PLATFORM_COMMIT_FRAMES=8

# ---------------- Speed assessment ----------------
# Sensor horizontal field of view, degrees. Absolute speed in m/s is only
# reported when this is set; without it the geometry is unconstrained and any
# figure would be invented. 0 disables. Typical: 60-70 for a phone camera.
SKUNK_CAMERA_HFOV_DEG=0

# ---------------- Performance ----------------
# Run the detector every Nth frame; the tracker coasts in between.
SKUNK_DETECTION_STRIDE=1
# Downscale width for inference only (display keeps FRAME_WIDTH). 0 = off.
SKUNK_INFERENCE_WIDTH=0
# Proximity-gate radius in multiples of target size, for keeping the track ID
# on a fast target whose boxes no longer overlap between frames.
SKUNK_TRACK_GATE_SCALE=4.0

# ---------------- Trajectory prediction (display only) ----------------
# Seconds ahead the predicted path extends.
SKUNK_TRAJECTORY_HORIZON=2.0
# Observations used for the fit (~1s of history at 25 fps).
SKUNK_TRAJECTORY_WINDOW=24
# Fit residual at which prediction confidence reaches zero.
SKUNK_TRAJECTORY_MAX_RESIDUAL=0.02

# ---------------- Intercept estimate (display only) ----------------
# Notional canister position, normalised frame coords. (0.5, 1.0) = bottom centre.
SKUNK_LAUNCH_POINT_X=0.5
SKUNK_LAUNCH_POINT_Y=1.0
# Notional interceptor speed, in frame widths per second.
SKUNK_INTERCEPTOR_SPEED=0.85
# Minimum trajectory confidence before an intercept estimate is offered.
SKUNK_INTERCEPT_MIN_CONFIDENCE=0.25

# ---------------- Video library ----------------
SKUNK_VIDEO_LIBRARY_DIR=assets/videos
SKUNK_UPLOAD_DIR=assets/videos/uploads
SKUNK_MAX_UPLOAD_MB=2048

# ---------------- Server ----------------
SKUNK_HOST=127.0.0.1
SKUNK_PORT=8000
SKUNK_LOG_LEVEL=INFO

# ---------------- Canister identity ----------------
# The deployed unit this console operates.
# SKUNK_CANISTER_ID=CANISTER 01

# ---------------- Engagement readiness ----------------
# Minimum sensor-frame projection confidence before a track counts as stable
# enough to engage. A track-quality measure, not a targeting quantity.
# SKUNK_READINESS_MIN_TRACK_STABILITY=0.25

# ---------------- Mission recording ----------------
# Every run writes a JSON report, so a demo doubles as a test.
# SKUNK_RECORD_RUNS=true
# SKUNK_RUNS_DIR=./runs
